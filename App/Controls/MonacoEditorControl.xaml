<UserControl
    x:Class="App.Controls.MonacoEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Grid x:Name="EditorHost" MinWidth="240" MinHeight="200"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <WebView2 x:Name="EditorWebView"
                  Opacity="0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <ProgressRing x:Name="LoadingRing" Width="28" Height="28"
                      IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
