<Page
    x:Class="App.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE950;" FontSize="11" />
                            <TextBlock Text="Model" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <ComboBox x:Name="ModelBox" MinWidth="150" Height="36"
                                  SelectionChanged="ModelBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE945;" FontSize="11" />
                            <TextBlock Text="Thinking" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <ComboBox x:Name="ThinkingBox" Width="112" Height="36" SelectedIndex="1">
                            <x:String>None</x:String><x:String>Smart</x:String><x:String>Plan</x:String>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="WorkspaceButton" Height="36" Padding="12,0" Margin="0,15,0,0"
                            Click="WorkspaceButton_Click" ToolTipService.ToolTip="Select the folder that tools can access">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock x:Name="WorkspaceText" Text="Choose workspace" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Width="36" Height="36" Padding="0" Margin="0,15,0,0" Click="ClearButton_Click"
                            ToolTipService.ToolTip="Clear conversation">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA99;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="ConversationHost" MaxWidth="960" HorizontalAlignment="Center" Spacing="14" Padding="4,8,8,16">
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,76,0,0">
                        <Border Width="64" Height="64" CornerRadius="20" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE8BD;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="How can I help?" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="Ask a question, attach context, or automate work in your workspace."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </Grid>

        <Border Grid.Row="2" MaxWidth="960" HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0" CornerRadius="14">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ItemsControl x:Name="AttachmentHost">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBox x:Name="ComposerBox" Grid.Row="1" MinHeight="56" MaxHeight="220" Margin="5"
                         Padding="14,10,14,6" AcceptsReturn="True" TextWrapping="Wrap"
                         FontSize="14"
                         PlaceholderText="Message Gemini..." BorderThickness="0" BorderBrush="Transparent"
                         Background="Transparent" KeyDown="ComposerBox_KeyDown">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>
                <Grid Grid.Row="2" Padding="10,0,10,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Height="34" Padding="10,0" Click="AttachButton_Click"
                                ToolTipService.ToolTip="Attach images or files">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE723;" FontSize="15" />
                                <TextBlock Text="Attach" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Enter to send · Ctrl + Enter for new line" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="StopButton" Width="34" Height="34" Padding="0"
                                Visibility="Collapsed" Click="StopButton_Click"
                                ToolTipService.ToolTip="Stop response">
                            <FontIcon Glyph="&#xE71A;" FontSize="13" />
                        </Button>
                        <Button x:Name="SendButton" Height="34" Padding="13,0"
                                Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Send" />
                                <FontIcon Glyph="&#xE724;" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
