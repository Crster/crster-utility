<Page
    x:Class="App.Pages.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="CardPadding">24</Thickness>
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollMode="Disabled"
                 Padding="32,0,32,32">
        <Grid MaxWidth="960"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,32,0,32">
                <TextBlock Text="Screen Recorder"
                          Style="{StaticResource TitleTextBlockStyle}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Capture your screen and save it as an MP4 video"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0" />
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <Button x:Name="StartRecordingButton"
                          Content="Start Recording"
                          Style="{StaticResource AccentButtonStyle}"
                          Padding="24,12,24,12"
                          Click="StartRecordingButton_Click" />
                <Button x:Name="StopRecordingButton"
                          Content="Stop Recording"
                          Background="#DC3545"
                          Foreground="White"
                          Padding="24,12,24,12"
                          IsEnabled="False"
                          Click="StopRecordingButton_Click" />
            </StackPanel>

            <!-- Status Card -->
            <Border Grid.Row="2"
                    x:Name="StatusCard"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Margin="0,24,0,0">
                <Grid Padding="{StaticResource CardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ProgressRing x:Name="RecordingProgressRing"
                                   Grid.Column="0"
                                   IsActive="False"
                                   Width="40"
                                   Height="40"
                                   Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="RecordingStatusText"
                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                  Text="Ready" />
                        <TextBlock x:Name="RecordingPathText"
                                  Style="{StaticResource CaptionTextBlockStyle}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Info -->
            <StackPanel Grid.Row="3"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Captures the primary display"
                          Style="{StaticResource SubtitleTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,4" />
                <TextBlock Text="Click Start Recording to capture the entire screen"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
