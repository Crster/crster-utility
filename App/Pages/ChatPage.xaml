<Page
    x:Class="App.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="16,20,16,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Section: Chat controls -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Personality" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ModelStatusText" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   ToolTipService.ToolTip="Active model and thinking effort"/>
                    </StackPanel>
                    <ComboBox x:Name="PersonalityBox" MinWidth="180" Height="36" SelectionChanged="PersonalityBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,15,0,0">
                    <Button x:Name="WorkspaceButton" Height="36" Padding="11,0" Click="WorkspaceButton_Click" Visibility="Collapsed"
                            ToolTipService.ToolTip="Choose Technician workspace">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock x:Name="WorkspaceButtonText" Text="Workspace"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="ContextButton" Height="36" Padding="11,0" Click="ContextButton_Click" ToolTipService.ToolTip="Show conversation context">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xF133;" FontSize="14"/>
                            <TextBlock Text="Context"/>
                            <Border x:Name="ContextCountBadge" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{ThemeResource AccentFillColorSecondaryBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="ContextCountText" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="CopyChatButton" Width="36" Height="36" Padding="0"
                            Click="CopyChatButton_Click" ToolTipService.ToolTip="Copy">
                        <FontIcon Glyph="&#xE8C8;" />
                    </Button>
                    <Button x:Name="CopyChatSummaryButton" Width="36" Height="36" Padding="0"
                            Click="CopyChatSummaryButton_Click" ToolTipService.ToolTip="Copy summary">
                        <FontIcon Glyph="&#xE9CE;" />
                    </Button>
                    <Button x:Name="ClearChatButton" Width="36" Height="36" Padding="0"
                            Click="ClearChatButton_Click" ToolTipService.ToolTip="Clear chat history"
                            AutomationProperties.Name="Clear chat history">
                        <FontIcon Glyph="&#xEA99;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section: Conversation context -->
        <Border x:Name="ContextPanel" Grid.Row="1" MaxWidth="1280" HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="14" Padding="16" Visibility="Collapsed">
            <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="System instruction" FontWeight="SemiBold"/>
                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8">
                        <ScrollViewer MaxHeight="200" Padding="12,10"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                            <TextBlock x:Name="SystemInstructionText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Conversation context" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="CompactButton" HorizontalAlignment="Right" Height="30" Padding="10,0"
                                Click="CompactButton_Click" ToolTipService.ToolTip="Compact this conversation into context">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE90D;" FontSize="12"/>
                                <TextBlock Text="Compact conversation" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="ContextTextBox" PlaceholderText="Add background, requirements, or reference text..."
                             MinHeight="112" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap"
                             TextChanged="ContextTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Section: Conversation -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="ConversationHost" HorizontalAlignment="Stretch" Spacing="14" Padding="4,8,8,16">
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,76,0,0">
                        <FontIcon Glyph="&#xE8BD;" FontSize="64"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyTitle" Text="How can I help?" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock x:Name="EmptyDescription" Text="Ask a question, or add reference material from Context."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </Grid>

        <!-- Section: Message composer -->
        <Border Grid.Row="3" MaxWidth="1280" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="5">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBox x:Name="ComposerBox" MinHeight="38" MaxHeight="144" Padding="10,7,6,7"
                             AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontSize="13" PlaceholderText="Message..."
                             BorderThickness="0" Background="Transparent" PreviewKeyDown="ComposerBox_PreviewKeyDown"
                             Paste="ComposerBox_Paste" TextChanged="ComposerBox_TextChanged">
                        <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent"/>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                <Button x:Name="SendButton" Grid.Column="1" Width="34" Height="34" Padding="0"
                        CornerRadius="17" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Click="SendButton_Click" ToolTipService.ToolTip="Send message">
                    <FontIcon x:Name="SendActionIcon" Glyph="&#xE724;" FontSize="13"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
