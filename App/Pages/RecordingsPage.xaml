<Page
    x:Class="App.Pages.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="CardPadding">24</Thickness>
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
        <Storyboard x:Key="RecordingWaveStoryboard">
            <DoubleAnimation Storyboard.TargetName="RecordingWaveTransform"
                             Storyboard.TargetProperty="X"
                             From="-150"
                             To="220"
                             Duration="0:0:1.25"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="RecordingWave"
                             Storyboard.TargetProperty="Opacity"
                             From="0.18"
                             To="0.42"
                             Duration="0:0:0.62"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollMode="Disabled"
                 Padding="32,0,32,32">
        <Grid MaxWidth="960"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,32,0,32">
                <TextBlock Text="Screen Recorder"
                          Style="{StaticResource TitleTextBlockStyle}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Capture your screen and save it as an MP4 video"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0" />
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <Button x:Name="RecordingButton"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Click="RecordingButton_Click">
                    <Grid MinWidth="145"
                          MinHeight="40">
                        <Border x:Name="RecordingButtonBase"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4">
                            <Grid>
                                <Border x:Name="RecordingWave"
                                        Width="112"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="4"
                                        Background="#55FFFFFF"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="RecordingWaveTransform"
                                                            X="-150" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="RecordingButtonLabel"
                                           Text="Start Recording"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="24,12" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Latest Recording -->
            <Border Grid.Row="2"
                    x:Name="LatestRecordingCard"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Margin="0,24,0,0">
                <StackPanel Padding="{StaticResource CardPadding}"
                            Spacing="18">
                    <Button x:Name="LatestRecordingButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Click="LatestRecordingButton_Click">
                        <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                CornerRadius="8">
                            <Image x:Name="LatestRecordingImage"
                                   Stretch="Uniform"
                                   MaxHeight="420"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="12" />
                        </Border>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <TextBlock Text="Duration"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestRecordingDurationText"
                                       Text="00:00"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="FPS"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestRecordingFpsText"
                                       Text="0.0"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="4"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="File Size"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestRecordingFileSizeText"
                                       Text="0 MB"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Info -->
            <StackPanel Grid.Row="2"
                        x:Name="InfoPanel"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Captures the primary display"
                          Style="{StaticResource SubtitleTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,4" />
                <TextBlock Text="Click Start Recording to capture the entire screen"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
