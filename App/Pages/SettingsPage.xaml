<Page
    x:Class="App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,32">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Changes are saved immediately." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Start with Windows" FontWeight="SemiBold"/><TextBlock Text="Launch Crster Utility hidden in the system tray after sign-in." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled"/></Grid>
                    <StackPanel Spacing="6"><TextBlock Text="Database folder" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NotebookPathBox" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Browse" Click="NotebookBrowseButton_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="OpenAI-compatible URL" FontWeight="SemiBold"/><TextBox x:Name="OpenAiCompatibleBaseUrlBox" PlaceholderText="https://api.openai.com/v1" LostFocus="OpenAiCompatibleBaseUrlBox_LostFocus"/></StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="API key" FontWeight="SemiBold"/><PasswordBox x:Name="OpenAiCompatibleApiKeyBox" PlaceholderText="Paste your API key" PasswordChanged="OpenAiCompatibleApiKeyBox_PasswordChanged" LostFocus="OpenAiCompatibleApiKeyBox_LostFocus"/></StackPanel>
                    <!-- Section: AI Models -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="AI models" FontWeight="SemiBold"/>
                        <AutoSuggestBox x:Name="LowCostModelBox" Header="Low Cost" PlaceholderText="Select a model" TextMemberPath="Name"
                                        PointerPressed="ModelBox_PointerPressed" LostFocus="ModelBox_LostFocus" PreviewKeyDown="ModelBox_PreviewKeyDown" TextChanged="ModelBox_TextChanged" SuggestionChosen="LowCostModelBox_SuggestionChosen"/>
                        <AutoSuggestBox x:Name="HighCostModelBox" Header="High Cost" PlaceholderText="Select a model" TextMemberPath="Name"
                                        PointerPressed="ModelBox_PointerPressed" LostFocus="ModelBox_LostFocus" PreviewKeyDown="ModelBox_PreviewKeyDown" TextChanged="ModelBox_TextChanged" SuggestionChosen="HighCostModelBox_SuggestionChosen"/>
                    </StackPanel>
                    <!-- Section: Location -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Location" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="CityBox" Header="City" PlaceholderText="Manila" LostFocus="LocationBox_LostFocus"/>
                            <TextBox x:Name="CountryBox" Grid.Column="1" Header="Country" PlaceholderText="Philippines" LostFocus="LocationBox_LostFocus"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6"><TextBlock Text="Snapshot shortcut" FontWeight="SemiBold"/><ComboBox x:Name="SnapshotShortcutBox" DisplayMemberPath="Name" SelectionChanged="SnapshotShortcutBox_SelectionChanged"/></StackPanel>
                    <!-- Section: Screen capture permission -->
                    <Border x:Name="ScreenCapturePermissionWarning" Visibility="Collapsed" Padding="12" CornerRadius="8"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Screen capture permission is off" FontWeight="SemiBold"/>
                                <TextBlock Text="Open Windows Settings, allow programmatic screenshots for Crster Utility, then return here and try again."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open settings" Click="OpenScreenCapturePrivacyButton_Click"
                                    AutomationProperties.Name="Open screen capture privacy settings"/>
                        </Grid>
                    </Border>
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Capture mouse cursor" FontWeight="SemiBold"/><TextBlock Text="Include the cursor in still snapshots." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="CursorToggle" Grid.Column="1" Toggled="CursorToggle_Toggled"/></Grid>
                    <StackPanel Spacing="6"><TextBlock Text="Recordings microphone" FontWeight="SemiBold"/><ComboBox x:Name="MicrophoneBox" SelectionChanged="MicrophoneBox_SelectionChanged"/></StackPanel>
                    <!-- Section: Microphone permission -->
                    <Border x:Name="MicrophonePermissionWarning" Visibility="Collapsed" Padding="12" CornerRadius="8"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Microphone permission is off" FontWeight="SemiBold"/>
                                <TextBlock Text="Open Windows Settings, allow microphone access for Crster Utility, then return here and try recording again."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open settings" Click="OpenMicrophonePrivacyButton_Click"
                                    AutomationProperties.Name="Open microphone privacy settings"/>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="6"><TextBlock Text="Caffeine shortcut" FontWeight="SemiBold"/><ComboBox x:Name="CaffeineShortcutBox" DisplayMemberPath="Name" SelectionChanged="CaffeineShortcutBox_SelectionChanged"/></StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
