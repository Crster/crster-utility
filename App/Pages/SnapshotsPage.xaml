<Page
    x:Class="App.Pages.SnapshotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="CardPadding">24</Thickness>
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollMode="Disabled"
                 Padding="20,16,20,32">
        <Grid MaxWidth="920"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Empty State -->
            <StackPanel Grid.Row="0"
                        x:Name="EmptyStatePanel"
                        Visibility="Visible"
                        Margin="0,48,0,0"
                        HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No snapshot yet"
                          Style="{StaticResource SubtitleTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,4" />
                <TextBlock Text="Click Capture Screen to take a screenshot and start editing"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <Button x:Name="CaptureButton"
                        Content="Capture Screen"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="CaptureScreenButton_Click"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0"
                        Padding="16,10" />
            </StackPanel>

            <!-- Result Card: Screenshot + Palette -->
            <Grid Grid.Row="0"
                  x:Name="ResultCard"
                  Visibility="Collapsed"
                  Margin="0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid Padding="{StaticResource CardPadding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Captured Screenshot"
                                          Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Click any color swatch to copy its hex value"
                                          Style="{StaticResource CaptionTextBlockStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="Capture another"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="CaptureScreenButton_Click"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="14,8" />
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                CornerRadius="8"
                                Margin="0,16,0,0">
                            <Image x:Name="ScreenshotDisplay"
                                    Stretch="Uniform"
                                    MaxHeight="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="12" />
                        </Border>

                        <TextBlock Grid.Row="2"
                                  Text="Color Palette"
                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                  Margin="0,24,0,12" />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="PaletteLeft"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,6,0" />

                            <StackPanel x:Name="PaletteRight"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Left"
                                        Margin="6,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
