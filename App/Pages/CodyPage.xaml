<Page
    x:Class="App.Pages.CodyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Controls">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="TerminalSplitterRow" Height="0"/>
            <RowDefinition x:Name="TerminalRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Section: Workspace toolbar -->
        <Border Padding="16,10" BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <SplitButton x:Name="WorkspaceSplitButton" MinWidth="150" MaxWidth="260" Height="34"
                             Padding="10,0" HorizontalAlignment="Left"
                             Click="WorkspaceSplitButton_Click"
                             ToolTipService.ToolTip="Choose a workspace">
                    <SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                            <TextBlock x:Name="WorkspaceNameText" Text="Choose workspace"
                                       MaxWidth="190" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Change workspace" Click="ChangeWorkspaceMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Scan project commands" Click="ScanCommandsMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE721;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <SplitButton x:Name="myColorButton" Height="34" Content="Scan commands"
                                 Click="RunButton_Click"
                                 ToolTipService.ToolTip="Run the selected workspace command">
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="RunMenu">
                                <MenuFlyoutItem Text="Scan project commands" Click="ScanCommandsMenuItem_Click"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <ToggleButton x:Name="TerminalButton" Height="34" Padding="10,0"
                                  Click="TerminalButton_Click" ToolTipService.ToolTip="Show terminal">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;" FontSize="13"/>
                            <TextBlock Text="Terminal"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="ThinkDeepButton" Width="34" Height="34" Padding="0"
                            Click="ThinkDeepButton_Click" ToolTipService.ToolTip="Think deep">
                        <FontIcon Glyph="&#xE945;" FontSize="13"/>
                    </Button>
                    <Button x:Name="BeSmartButton" Width="34" Height="34" Padding="0"
                            Click="BeSmartButton_Click" ToolTipService.ToolTip="Be smart">
                        <FontIcon Glyph="&#xE7BE;" FontSize="13"/>
                    </Button>
                    <Button x:Name="CopySessionButton" Width="34" Height="34" Padding="0"
                            Click="CopySessionButton_Click" ToolTipService.ToolTip="Copy Cody session">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                    </Button>
                    <ToggleButton x:Name="ContextButton" Width="34" Height="34" Padding="0"
                                  Click="ContextButton_Click" ToolTipService.ToolTip="Show agent context"
                                  AutomationProperties.Name="Show agent context">
                        <FontIcon Glyph="&#xF133;" FontSize="13"/>
                    </ToggleButton>
                    <Button x:Name="ClearSessionButton" Width="34" Height="34" Padding="0"
                            Click="ClearSessionButton_Click" ToolTipService.ToolTip="Clear Cody session"
                            AutomationProperties.Name="Clear Cody session">
                        <FontIcon Glyph="&#xEA99;" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section: Coding workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="0"/>
                <ColumnDefinition x:Name="FilesSplitterColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ContextColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FilesPanel" Visibility="Collapsed" BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="FileSearchBox" Height="32"
                                    PlaceholderText="Search files and content"
                                    QueryIcon="Find" TextMemberPath="RelativePath"
                                    TextChanged="FileSearchBox_TextChanged"
                                    QuerySubmitted="FileSearchBox_QuerySubmitted"
                                    SuggestionChosen="FileSearchBox_SuggestionChosen">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8,4" Text="{Binding RelativePath}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2">
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="CollapseWorkspaceButton_Click" ToolTipService.ToolTip="Collapse all folders"
                                AutomationProperties.Name="Collapse all folders">
                            <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="RefreshWorkspaceButton_Click" ToolTipService.ToolTip="Refresh workspace files"
                                AutomationProperties.Name="Refresh workspace files">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        </Button>
                        <ToggleButton x:Name="ChangesButton" Width="32" Height="32" Padding="0"
                                      Background="Transparent" BorderThickness="0" Click="ChangesButton_Click"
                                      ToolTipService.ToolTip="Show new and modified files"
                                      AutomationProperties.Name="Changes">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        </ToggleButton>
                        <Button x:Name="AddWorkspaceEntryButton" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" Click="AddWorkspaceEntryButton_Click"
                                ToolTipService.ToolTip="New file or folder"
                                AutomationProperties.Name="New file or folder">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TreeView x:Name="WorkspaceTree" Grid.Row="2"
                              SelectionMode="Single" ItemInvoked="WorkspaceTree_ItemInvoked"
                              Expanding="WorkspaceTree_Expanding"
                              DoubleTapped="WorkspaceTree_DoubleTapped"
                              RightTapped="WorkspaceTree_RightTapped">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,3" ColumnSpacing="7" Opacity="{Binding Content.Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Content.Icon}" Width="16" Height="16"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Content.Name}"
                                               Foreground="{Binding Content.Foreground}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="FileLoadingRing" Width="14" Height="14"
                                      IsActive="False" Visibility="Collapsed"/>
                        <TextBlock x:Name="FileStatusText" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:ResizeHandle x:Name="FilesSplitter" Grid.Column="1" Width="6"
                                  Visibility="Collapsed" PointerPressed="FilesSplitter_PointerPressed"
                                  PointerMoved="FilesSplitter_PointerMoved"
                                  PointerReleased="FilesSplitter_PointerReleased"
                                  PointerCanceled="FilesSplitter_PointerCanceled"
                                  ToolTipService.ToolTip="Resize file sidebar"
                                  AutomationProperties.Name="Resize file sidebar"/>

            <TabView x:Name="EditorTabs" Grid.Column="2" IsAddTabButtonVisible="False"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                     SelectionChanged="EditorTabs_SelectionChanged"
                     TabCloseRequested="EditorTabs_TabCloseRequested">
                <TabViewItem x:Name="HomeTab" IsClosable="False">
                    <TabViewItem.Header>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="230" Height="32" CornerRadius="0" Padding="10,0">
                            <TextBlock Text="Cody" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </TabViewItem.Header>
                    <Grid Padding="20,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ConversationHost" Spacing="10">
                                <StackPanel x:Name="CodyEmptyState" HorizontalAlignment="Center" Margin="0,64,0,0" Spacing="8">
                                    <Border Width="64" Height="64" CornerRadius="18"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE943;" FontSize="30"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Opacity="0.65"/>
                                    </Border>
                                    <TextBlock Text="Build with Cody" Style="{StaticResource SubtitleTextBlockStyle}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Choose a workspace, then ask Cody to inspect, change, or run your project."
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" BorderThickness="1" CornerRadius="14" Padding="6"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,8">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PromptBox" MinHeight="38" MaxHeight="140"
                                         Padding="10,8" AcceptsReturn="True"
                                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         PlaceholderText="Ask Cody to inspect, change, or run your project..."
                                         PreviewKeyDown="PromptBox_PreviewKeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                                        <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent"/>
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button x:Name="SendButton" Grid.Column="1" Width="34" Height="34" Padding="0"
                                        Margin="0,0,2,2" VerticalAlignment="Bottom" CornerRadius="9"
                                        Style="{StaticResource AccentButtonStyle}" Click="SendButton_Click"
                                        ToolTipService.ToolTip="Send prompt">
                                    <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="13"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>

            <Grid x:Name="MonacoPreloadHost" Grid.Column="2" Margin="0,42,0,0"
                  Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="10"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>

            <Border x:Name="ContextPanel" Grid.Column="3" Visibility="Collapsed"
                    BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Agent context" FontWeight="SemiBold"/>
                        <TextBlock Text="System instruction" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="SystemInstructionBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="140"/>
                        <TextBlock Text="Session context" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="ContextTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="160" TextChanged="ContextTextBox_TextChanged"/>
                        <TextBlock x:Name="ModelText" FontSize="11" Opacity="0.7"/>
                        <Button Content="Compact conversation" HorizontalAlignment="Left"
                                Click="CompactContextButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Section: Terminal -->
        <controls:ResizeHandle x:Name="TerminalSplitter" Grid.Row="2" Height="6"
                              IsVerticalResize="True" Visibility="Collapsed"
                              PointerPressed="TerminalSplitter_PointerPressed"
                              PointerMoved="TerminalSplitter_PointerMoved"
                              PointerReleased="TerminalSplitter_PointerReleased"
                              PointerCanceled="TerminalSplitter_PointerCanceled"
                              ToolTipService.ToolTip="Resize terminal"
                              AutomationProperties.Name="Resize terminal"/>

        <Border x:Name="TerminalPanel" Grid.Row="3" Visibility="Collapsed" BorderThickness="0,1,0,0"
                SizeChanged="TerminalPanel_SizeChanged"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="#FF0C0C0C">
            <TabView x:Name="TerminalTabs" IsAddTabButtonVisible="False"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                     SelectionChanged="TerminalTabs_SelectionChanged"
                     TabCloseRequested="TerminalTabs_TabCloseRequested">
                <TabViewItem x:Name="InteractiveTerminalTab" IsClosable="False"
                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="13"/>
                            <ComboBox x:Name="TerminalTypeBox" Width="145" Height="30" Padding="4,0"
                                      Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="TerminalTypeBox_SelectionChanged"
                                      ToolTipService.ToolTip="Choose terminal shell">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent"/>
                                </ComboBox.Resources>
                            </ComboBox>
                            <Button Padding="8,0" Click="TerminalActionsButton_Click"
                                    ToolTipService.ToolTip="Terminal actions"
                                    AutomationProperties.Name="Terminal actions">
                                <FontIcon Glyph="&#xE712;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </TabViewItem.Header>
                <Grid x:Name="InteractiveTerminalHost" MinHeight="120"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </TabViewItem>
            </TabView>
        </Border>
    </Grid>
</Page>
