<Page
    x:Class="App.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Padding="16,20,16,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Section: Chat controls -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Personality" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="PersonalityBox" MinWidth="180" Height="36" SelectionChanged="PersonalityBox_SelectionChanged"/>
                    <Button x:Name="InstructionButton" Height="36" Padding="8,0" MaxWidth="320"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Show the system instruction"
                            AutomationProperties.Name="Show the system instruction">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="ModelStatusText" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="InstructionFlyout" Placement="BottomEdgeAlignedLeft"
                                    Opening="InstructionFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="900"/>
                                        <Setter Property="MaxHeight" Value="560"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid Width="860" RowSpacing="10" Padding="14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="System instruction" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="CopyInstructionButton" Grid.Column="1" Height="30" Padding="10,0"
                                                Click="CopyInstructionButton_Click"
                                                ToolTipService.ToolTip="Copy the system instruction"
                                                AutomationProperties.Name="Copy the system instruction">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                                <TextBlock x:Name="CopyInstructionText" Text="Copy" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="1" CornerRadius="6"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <ScrollViewer MaxHeight="420" Padding="12,10"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollMode="Disabled">
                                            <TextBlock x:Name="SystemInstructionText" FontSize="12"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="CopyChatButton" Width="36" Height="36" Padding="0"
                                Click="CopyChatButton_Click" ToolTipService.ToolTip="Copy chat"
                                AutomationProperties.Name="Copy chat">
                            <FontIcon Glyph="&#xE8C8;" />
                        </Button>
                        <Button x:Name="CopyChatSummaryButton" Width="36" Height="36" Padding="0"
                                Click="CopyChatSummaryButton_Click" ToolTipService.ToolTip="Copy chat summary"
                                AutomationProperties.Name="Copy chat summary">
                            <FontIcon Glyph="&#xE9CE;" />
                        </Button>
                        <Button x:Name="SaveChatButton" Width="36" Height="36" Padding="0"
                                Click="SaveChatButton_Click" ToolTipService.ToolTip="Save this chat"
                                AutomationProperties.Name="Save this chat">
                            <FontIcon Glyph="&#xE74E;" />
                        </Button>
                        <ToggleButton x:Name="SavedChatsButton" Width="36" Height="36" Padding="0"
                                      Click="SavedChatsButton_Click" ToolTipService.ToolTip="Show saved chats"
                                      AutomationProperties.Name="Show saved chats">
                            <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                        </ToggleButton>
                        <Button x:Name="ClearChatButton" Width="36" Height="36" Padding="0"
                                Click="ClearChatButton_Click" ToolTipService.ToolTip="Clear chat history"
                                AutomationProperties.Name="Clear chat history">
                            <FontIcon Glyph="&#xEA99;" />
                        </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section: Conversation -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="ConversationHost" HorizontalAlignment="Stretch" Spacing="14" Padding="4,8,8,16">
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,76,0,0">
                        <FontIcon Glyph="&#xE8BD;" FontSize="64"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyTitle" Text="How can I help?" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock x:Name="EmptyDescription" Text="Ask a question to start a new chat."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"/>
                        <Border x:Name="EmptyDisclaimer" Margin="0,20,0,0" MaxWidth="500" Padding="12,10"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="EmptyDisclaimerIcon" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Top"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="EmptyDisclaimerText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="440"
                                           Text="AI can make mistakes. Check important answers yourself."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </Grid>

        <!-- Section: Message composer -->
        <Border x:Name="ComposerCard" Grid.Row="2" MaxWidth="1280" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="6,6,6,4"
                Translation="0,0,4"><!-- Focus lifts the card instead of drawing a ring; see ComposerBox_GotFocus -->
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <StackPanel Spacing="2">
                <!-- Attachments added by paste or the attach button -->
                <ScrollViewer x:Name="AttachmentStrip" Visibility="Collapsed" Margin="4,2,4,4"
                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AttachmentChipHost" Orientation="Horizontal" Spacing="6"/>
                </ScrollViewer>
                <StackPanel>
                    <TextBox x:Name="ComposerBox" MinHeight="38" MaxHeight="144" Padding="10,7,6,7"
                             AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontSize="13" PlaceholderText="Message..."
                             BorderThickness="0" Background="Transparent" PreviewKeyDown="ComposerBox_PreviewKeyDown"
                             Paste="ComposerBox_Paste" TextChanged="ComposerBox_TextChanged"
                             GotFocus="ComposerBox_GotFocus" LostFocus="ComposerBox_LostFocus">
                        <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent"/>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <!-- Composer actions and hints -->
                <Grid ColumnSpacing="8" Padding="2,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AttachButton" Width="32" Height="32" Padding="0" CornerRadius="16"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            Click="AttachButton_Click" ToolTipService.ToolTip="Attach an image or text file"
                            AutomationProperties.Name="Attach a file">
                        <FontIcon Glyph="&#xE723;" FontSize="14"/>
                    </Button>
                    <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="ComposerHintText" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Enter to send · Shift+Enter for a new line"/>
                        <Button x:Name="SendButton" Width="34" Height="34" Padding="0"
                                CornerRadius="17" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                Click="SendButton_Click" ToolTipService.ToolTip="Send message"
                                AutomationProperties.Name="Send message">
                            <FontIcon x:Name="SendActionIcon" Glyph="&#xE724;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        </Grid>

        <!-- Section: Saved chats -->
        <Border x:Name="SavedChatsPanel" Grid.Column="1" Visibility="Collapsed"
                Margin="0,20,16,24" MinWidth="260"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="14" Padding="14,12,8,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved chats" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="HideSavedChatsButton" Grid.Column="1" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Click="HideSavedChatsButton_Click" ToolTipService.ToolTip="Hide saved chats"
                            AutomationProperties.Name="Hide saved chats">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <ListView x:Name="SavedChatsList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="SavedChatsList_ItemClick"
                              HorizontalContentAlignment="Stretch" Padding="0,0,6,0"
                              AutomationProperties.Name="Saved chats">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <StackPanel x:Name="SavedChatsEmptyState" VerticalAlignment="Center" Spacing="8"
                                Margin="6,0,12,0" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE81C;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                        <TextBlock Text="No saved chats yet" HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Use Save to keep a chat and open it again later."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
