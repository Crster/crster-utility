<Page
    x:Class="App.Pages.CodyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="TerminalRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Section: Workspace toolbar -->
        <Border Padding="16,10" BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <SplitButton x:Name="WorkspaceSplitButton" MinWidth="150" MaxWidth="260" Height="34"
                             Padding="10,0" HorizontalAlignment="Left"
                             Click="WorkspaceSplitButton_Click"
                             ToolTipService.ToolTip="Choose a workspace">
                    <SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                            <TextBlock x:Name="WorkspaceNameText" Text="Choose workspace"
                                       MaxWidth="190" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Change workspace" Click="ChangeWorkspaceMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Scan project commands" Click="ScanCommandsMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE721;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <SplitButton x:Name="myColorButton" Height="34" Content="Scan commands"
                                 Click="RunButton_Click"
                                 ToolTipService.ToolTip="Run the selected workspace command">
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="RunMenu">
                                <MenuFlyoutItem Text="Scan project commands" Click="ScanCommandsMenuItem_Click"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <ToggleButton x:Name="TerminalButton" Height="34" Padding="10,0"
                                  Click="TerminalButton_Click" ToolTipService.ToolTip="Show terminal">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;" FontSize="13"/>
                            <TextBlock Text="Terminal"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ContextButton" Height="34" Padding="10,0"
                                  Click="ContextButton_Click" ToolTipService.ToolTip="Show agent context">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="13"/>
                            <TextBlock Text="Context"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section: Coding workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ContextColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FilesPanel" Visibility="Collapsed" BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="FileSearchBox" PlaceholderText="Search files and content"
                                        TextChanged="FileSearchBox_TextChanged"
                                        QuerySubmitted="FileSearchBox_QuerySubmitted"/>
                        <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                                Click="AgentSearchButton_Click" ToolTipService.ToolTip="Search with Cody"
                                AutomationProperties.Name="Search workspace with Cody">
                            <FontIcon Glyph="&#xE721;" FontSize="13"/>
                        </Button>
                        <Button Grid.Column="2" Width="32" Height="32" Padding="0"
                                Click="CollapseWorkspaceButton_Click" ToolTipService.ToolTip="Collapse all folders"
                                AutomationProperties.Name="Collapse all folders">
                            <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                        </Button>
                        <Button x:Name="AddWorkspaceEntryButton" Grid.Column="3" Width="32" Height="32" Padding="0"
                                Click="AddWorkspaceEntryButton_Click" ToolTipService.ToolTip="New file or folder"
                                AutomationProperties.Name="New file or folder">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        </Button>
                        <Button Grid.Column="4" Width="32" Height="32" Padding="0"
                                Click="RefreshWorkspaceButton_Click" ToolTipService.ToolTip="Refresh workspace files"
                                AutomationProperties.Name="Refresh workspace files">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <TreeView x:Name="WorkspaceTree" Grid.Row="1"
                              SelectionMode="Single" ItemInvoked="WorkspaceTree_ItemInvoked"
                              DoubleTapped="WorkspaceTree_DoubleTapped"
                              RightTapped="WorkspaceTree_RightTapped">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,3" ColumnSpacing="7" Opacity="{Binding Content.Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Content.Glyph}" FontSize="13"
                                              Foreground="{Binding Content.Foreground}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Content.Name}"
                                               Foreground="{Binding Content.Foreground}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock x:Name="FileStatusText" Grid.Row="2" FontSize="11" Opacity="0.7"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <TabView x:Name="EditorTabs" Grid.Column="1" IsAddTabButtonVisible="False"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                     SelectionChanged="EditorTabs_SelectionChanged"
                     TabCloseRequested="EditorTabs_TabCloseRequested">
                <TabViewItem x:Name="HomeTab" Header="Cody" IsClosable="False">
                    <Grid Padding="20,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ConversationHost" Spacing="10">
                                <StackPanel x:Name="CodyEmptyState" HorizontalAlignment="Center" Margin="0,64,0,0" Spacing="8">
                                    <Border Width="64" Height="64" CornerRadius="18"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE943;" FontSize="30"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Opacity="0.65"/>
                                    </Border>
                                    <TextBlock Text="Build with Cody" Style="{StaticResource SubtitleTextBlockStyle}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Choose a workspace, then ask Cody to inspect, change, or run your project."
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" BorderThickness="1" CornerRadius="14" Padding="6,6,6,5"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Translation="0,0,8">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="PromptBox" MinHeight="58" MaxHeight="160"
                                         Padding="10,8" AcceptsReturn="True"
                                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         PlaceholderText="Ask Cody to inspect, change, or run your project..."
                                         PreviewKeyDown="PromptBox_PreviewKeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                                        <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent"/>
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                                <Grid Grid.Row="1" Padding="8,0,2,1">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Name="ComposerWorkspaceText" Text="No workspace selected"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                                Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl+Enter to send" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <Button x:Name="SendButton" Width="34" Height="34" Padding="0"
                                                CornerRadius="9" Style="{StaticResource AccentButtonStyle}"
                                                Click="SendButton_Click" ToolTipService.ToolTip="Send prompt">
                                            <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>
            </TabView>

            <Grid x:Name="MonacoPreloadHost" Grid.Column="1" Margin="0,42,0,0"
                  Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="10"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>

            <Border x:Name="ContextPanel" Grid.Column="2" Visibility="Collapsed"
                    BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Agent context" FontWeight="SemiBold"/>
                        <TextBlock Text="System instruction" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="SystemInstructionBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="140"/>
                        <TextBlock Text="Session context" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="ContextTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="160" TextChanged="ContextTextBox_TextChanged"/>
                        <TextBlock x:Name="ModelText" FontSize="11" Opacity="0.7"/>
                        <Button Content="Compact conversation" HorizontalAlignment="Left"
                                Click="CompactContextButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Section: Terminal -->
        <Border x:Name="TerminalPanel" Grid.Row="2" Visibility="Collapsed" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="#FF0C0C0C">
                <Grid Padding="16,10" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" Foreground="#FFBDBDBD" FontSize="13"/>
                        <TextBlock Text="PowerShell" Foreground="#FFF0F0F0" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button Content="Cancel" Padding="8,2" Click="CancelTerminalButton_Click"/>
                        <Button Content="Clear" Padding="8,2" Click="ClearTerminalButton_Click"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="TerminalScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TerminalOutputText" Foreground="#FFD7D7D7"
                               FontFamily="Cascadia Mono" FontSize="12"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PS&gt;" Foreground="#FF58D68D" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono"/>
                    <TextBox x:Name="TerminalInputBox" Grid.Column="1" FontFamily="Cascadia Mono"
                             KeyDown="TerminalInputBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Run" Click="TerminalRunButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
