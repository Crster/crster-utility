<UserControl
    x:Class="App.Controls.Noteblock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Root"
            Padding="10"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            CornerRadius="6"
            GotFocus="Root_GotFocus"
            LostFocus="Root_LostFocus"
            PointerEntered="Root_PointerEntered"
            PointerExited="Root_PointerExited">
        <ScrollViewer x:Name="BlockScrollViewer"
                      MaxHeight="300"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden">
            <Grid x:Name="ContentHost" />
        </ScrollViewer>
    </Border>
</UserControl>
