<Page
    x:Class="App.Pages.CodyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Controls"
    NavigationCacheMode="Required"
    PreviewKeyDown="CodyPage_PreviewKeyDown">
    <Page.Resources>
        <Storyboard x:Name="ScanCommandsSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanCommandsIconRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1"/>
        </Storyboard>
    </Page.Resources>
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="TerminalSplitterRow" Height="0"/>
            <RowDefinition x:Name="TerminalRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Section: Workspace toolbar -->
        <Border Padding="16,10" BorderThickness="0,0,0,1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="ToolbarGrid" VerticalAlignment="Top" SizeChanged="ToolbarGrid_SizeChanged">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel x:Name="WorkspaceInfoStackPanel" Orientation="Horizontal" Spacing="14" Grid.Row="0" Grid.Column="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    <SplitButton x:Name="WorkspaceSplitButton" MinWidth="150" MaxWidth="260" Height="34"
                                 Padding="10,0" HorizontalAlignment="Left"
                                 Click="WorkspaceSplitButton_Click"
                                 ToolTipService.ToolTip="Choose a workspace">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                <TextBlock x:Name="WorkspaceNameText" Text="Choose workspace"
                                           MaxWidth="190" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout Opening="OverlappingFlyout_Opening" Closed="OverlappingFlyout_Closed">
                                <MenuFlyoutItem Text="Change workspace" Click="ChangeWorkspaceMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <DropDownButton x:Name="AgentSelectorButton" Height="34" Padding="10,0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Choose which agent is active"
                                    AutomationProperties.Name="Choose which agent is active">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon x:Name="AgentSelectorIcon" Glyph="&#xE943;" FontSize="12"/>
                            <TextBlock x:Name="AgentSelectorText" Text="Cody" FontSize="12"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="AgentSelectorFlyout" Placement="BottomEdgeAlignedLeft"
                                        Opening="OverlappingFlyout_Opening" Closed="OverlappingFlyout_Closed"/>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="InstructionButton" Height="34" Padding="8,0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Show the system instruction"
                            AutomationProperties.Name="Show the system instruction">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="ModelStatusText" FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="InstructionFlyout" Placement="BottomEdgeAlignedLeft"
                                    Opening="InstructionFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="900"/>
                                        <Setter Property="MaxHeight" Value="560"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid Width="860" RowSpacing="10" Padding="14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="System instruction" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="CopyInstructionButton" Grid.Column="1"
                                                Height="30" Padding="10,0"
                                                Click="CopyInstructionButton_Click"
                                                ToolTipService.ToolTip="Copy the system instruction"
                                                AutomationProperties.Name="Copy the system instruction">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                                <TextBlock x:Name="CopyInstructionText" Text="Copy" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="1" CornerRadius="6"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <ScrollViewer MaxHeight="420" Padding="12,10"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollMode="Disabled">
                                            <TextBlock x:Name="InstructionText" FontSize="12"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                
                <StackPanel x:Name="ActionsStackPanel" Orientation="Horizontal" Spacing="6"
                            Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ToggleButton x:Name="SmartToggle" Height="34" Padding="10,0"
                                      Checked="ModeToggle_Changed" Unchecked="ModeToggle_Changed"
                                      AutomationProperties.Name="Be smart">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE7BE;" FontSize="12"/>
                                <TextBlock Text="Be smart" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ThinkToggle" Height="34" Padding="10,0"
                                      Checked="ModeToggle_Changed" Unchecked="ModeToggle_Changed"
                                      AutomationProperties.Name="Think deep">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE945;" FontSize="12"/>
                                <TextBlock Text="Think deep" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="McpToggle" Height="34" Padding="10,0" Visibility="Collapsed"
                                      Checked="McpToggle_Changed" Unchecked="McpToggle_Changed"
                                      ToolTipService.ToolTip="Let the hosted CLI use Cody's editor, dialogs, saved commands and todo list"
                                      AutomationProperties.Name="Offer Cody tools to the hosted CLI">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE71B;" FontSize="12"/>
                                <TextBlock Text="Cody tools" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="ClearButton" Width="34" Height="34" Padding="0"
                                Click="ClearButton_Click"
                                ToolTipService.ToolTip="Clear history and start a new session"
                                AutomationProperties.Name="Clear history and start a new session">
                            <FontIcon Glyph="&#xEA99;" FontSize="12"/>
                        </Button>
                        <Border Width="1" Height="20" Margin="4,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <SplitButton x:Name="RunCommandButton" Height="34" Padding="10,0"
                                     Click="RunButton_Click"
                                     ToolTipService.ToolTip="Run the selected workspace command">
                            <SplitButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock x:Name="RunCommandText" Text="Scan workspace" FontSize="12"
                                               MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight"
                                        Opening="OverlappingFlyout_Opening" Closed="OverlappingFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="MaxWidth" Value="380"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
                                            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid Width="352">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Padding="14,12,14,10" Spacing="2">
                                            <TextBlock Text="Workspace commands" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Read from .crster\cody.json. Edit that file to add, change, or remove a command."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" MaxHeight="320" Padding="8,0,8,8"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollMode="Disabled">
                                            <StackPanel x:Name="RunCommandItemsPanel" Spacing="2"/>
                                        </ScrollViewer>

                                        <Border Grid.Row="2" Padding="8" BorderThickness="0,1,0,0"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                                CornerRadius="0,0,8,8">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ScanCommandsButton" Height="32" Padding="10,0"
                                                        HorizontalAlignment="Stretch"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Click="ScanCommandsMenuItem_Click"
                                                        ToolTipService.ToolTip="Discover workspace commands"
                                                        AutomationProperties.Name="Scan workspace commands">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon x:Name="ScanCommandsIcon" Glyph="&#xE895;" FontSize="12"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform x:Name="ScanCommandsIconRotation"/>
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                        <TextBlock x:Name="ScanCommandsText" Text="Scan workspace" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="OpenCommandsFileButton" Grid.Column="1"
                                                        Height="32" Padding="10,0"
                                                        Click="OpenCommandsFileButton_Click"
                                                        ToolTipService.ToolTip="Open .crster\cody.json in the editor"
                                                        AutomationProperties.Name="Open cody.json in the editor">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                                        <TextBlock Text="Edit file" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Flyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <ToggleButton x:Name="TerminalButton" Height="34" Padding="10,0"
                                      Click="TerminalButton_Click" ToolTipService.ToolTip="Show or hide terminal (Ctrl+`)"
                                      AutomationProperties.Name="Show or hide terminal">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE756;" FontSize="13"/>
                                <TextBlock Text="Terminal"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
        </Border>

        <!-- Section: Coding workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="0"/>
                <ColumnDefinition x:Name="FilesSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="EditorColumn" Width="0"/>
                <ColumnDefinition x:Name="CodyChatColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FilesPanel" Visibility="Collapsed" BorderThickness="0,0,1,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="FileSearchBox" Height="32"
                                    PlaceholderText="Search files and content"
                                    QueryIcon="Find" TextMemberPath="RelativePath"
                                    TextChanged="FileSearchBox_TextChanged"
                                    QuerySubmitted="FileSearchBox_QuerySubmitted"
                                    SuggestionChosen="FileSearchBox_SuggestionChosen">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8,4" Text="{Binding RelativePath}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2">
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="CollapseWorkspaceButton_Click" ToolTipService.ToolTip="Collapse all folders"
                                AutomationProperties.Name="Collapse all folders">
                            <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="RefreshWorkspaceButton_Click" ToolTipService.ToolTip="Refresh workspace files"
                                AutomationProperties.Name="Refresh workspace files">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        </Button>
                        <ToggleButton x:Name="ChangesButton" Width="32" Height="32" Padding="0"
                                      Background="Transparent" BorderThickness="0" Click="ChangesButton_Click"
                                      ToolTipService.ToolTip="Show new and modified files"
                                      AutomationProperties.Name="Changes">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        </ToggleButton>
                        <Button x:Name="AddWorkspaceEntryButton" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" Click="AddWorkspaceEntryButton_Click"
                                ToolTipService.ToolTip="New file or folder"
                                AutomationProperties.Name="New file or folder">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TreeView x:Name="WorkspaceTree" Grid.Row="2"
                              SelectionMode="Single" ItemInvoked="WorkspaceTree_ItemInvoked"
                              Expanding="WorkspaceTree_Expanding"
                              DoubleTapped="WorkspaceTree_DoubleTapped"
                              RightTapped="WorkspaceTree_RightTapped">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,3" ColumnSpacing="7" Opacity="{Binding Content.Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Content.Icon}" Width="16" Height="16"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Content.Name}"
                                               Foreground="{Binding Content.Foreground}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                        <ProgressRing x:Name="FileLoadingRing" Width="14" Height="14"
                                      IsActive="False" Visibility="Collapsed"/>
                        <TextBlock x:Name="FileStatusText" FontSize="11" Opacity="0.7"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:ResizeHandle x:Name="FilesSplitter" Grid.Column="1" Width="6"
                                  Visibility="Collapsed" PointerPressed="FilesSplitter_PointerPressed"
                                  PointerMoved="FilesSplitter_PointerMoved"
                                  PointerReleased="FilesSplitter_PointerReleased"
                                  PointerCanceled="FilesSplitter_PointerCanceled"
                                  ToolTipService.ToolTip="Resize file sidebar"
                                  AutomationProperties.Name="Resize file sidebar"/>

            <TabView x:Name="EditorTabs" Grid.Column="2" IsAddTabButtonVisible="True"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                     AddTabButtonClick="EditorTabs_AddTabButtonClick"
                     SelectionChanged="EditorTabs_SelectionChanged"
                     TabCloseRequested="EditorTabs_TabCloseRequested">
                <TabViewItem x:Name="HomeTab" IsClosable="False" Visibility="Collapsed"
                             ContentTransitions="{x:Null}">
                    <TabViewItem.Header>
                        <TextBlock x:Name="HomeTabHeaderText" Text="Cody"/>
                    </TabViewItem.Header>
                    <!-- One surface so the active agent, Cody or a hosted CLI, gets the same
                         home tab and the same 30% side rail when an editor is open. -->
                    <Grid x:Name="AgentSurface">
                        <controls:CodyChatPanel x:Name="CodyChat"/>
                        <controls:CliAgentPanel x:Name="CliAgentView" Visibility="Collapsed"/>
                    </Grid>
                </TabViewItem>
            </TabView>

            <Grid x:Name="MonacoPreloadHost" Grid.Column="2" Margin="0,42,0,0"
                  Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="10"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border x:Name="CodyChatDock" Grid.Column="3" Visibility="Collapsed" MinWidth="340"
                    BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ContentControl x:Name="CodyChatHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>

        </Grid>

        <!-- Section: Terminal -->
        <controls:ResizeHandle x:Name="TerminalSplitter" Grid.Row="2" Height="6"
                              IsVerticalResize="True" Visibility="Collapsed" IsHitTestVisible="False"
                              PointerPressed="TerminalSplitter_PointerPressed"
                              PointerMoved="TerminalSplitter_PointerMoved"
                              PointerReleased="TerminalSplitter_PointerReleased"
                              PointerCanceled="TerminalSplitter_PointerCanceled"
                              ToolTipService.ToolTip="Resize terminal"
                              AutomationProperties.Name="Resize terminal"/>

        <Border x:Name="TerminalPanel" Grid.Row="3" Visibility="Collapsed" BorderThickness="0,1,0,0"
                SizeChanged="TerminalPanel_SizeChanged"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="#FF0C0C0C">
            <TabView x:Name="TerminalTabs" IsAddTabButtonVisible="True"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                     AddTabButtonClick="TerminalTabs_AddTabButtonClick"
                     SelectionChanged="TerminalTabs_SelectionChanged"
                     TabCloseRequested="TerminalTabs_TabCloseRequested">
                <TabView.Resources>
                    <Thickness x:Key="TabViewItemAddButtonContainerPadding">3,0,0,7</Thickness>
                </TabView.Resources>
                <TabViewItem x:Name="InteractiveTerminalTab" IsClosable="False"
                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="13"/>
                            <ComboBox x:Name="TerminalTypeBox" Width="145" Height="30" Padding="4,0"
                                      Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="TerminalTypeBox_SelectionChanged"
                                      ToolTipService.ToolTip="Choose terminal shell">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent"/>
                                </ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>
                    </TabViewItem.Header>
                <Grid x:Name="InteractiveTerminalHost" MinHeight="120"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock x:Name="TerminalPlaceholderText" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" Foreground="#FF9D9D9D"
                               Text="Choose a workspace to start a terminal."/>
                </Grid>
                </TabViewItem>
            </TabView>
        </Border>
    </Grid>
</Page>
