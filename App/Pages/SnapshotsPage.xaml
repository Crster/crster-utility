<Page
    x:Class="App.Pages.SnapshotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="CardPadding">24</Thickness>
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollMode="Disabled"
                 Padding="32,0,32,32">
        <Grid MaxWidth="960"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,32,0,32">
                <TextBlock Text="Snapshot Studio"
                          Style="{StaticResource TitleTextBlockStyle}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Capture, edit, and extract color palettes from your screen"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0" />
            </StackPanel>

            <!-- Capture Button -->
            <Button Grid.Row="1"
                    x:Name="CaptureButton"
                    Content="Capture Screen"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CaptureScreenButton_Click"
                    HorizontalAlignment="Center"
                    Padding="24,12,24,12" />

            <!-- Empty State -->
            <StackPanel Grid.Row="2"
                        x:Name="EmptyStatePanel"
                        Visibility="Visible"
                        Margin="0,64,0,0"
                        HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="No snapshot yet"
                          Style="{StaticResource SubtitleTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,4" />
                <TextBlock Text="Click Capture Screen to take a screenshot and start editing"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Result Card: Screenshot + Palette -->
            <Grid Grid.Row="2"
                  x:Name="ResultCard"
                  Visibility="Collapsed"
                  Margin="0,24,0,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid Padding="{StaticResource CardPadding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Captured Screenshot"
                                      Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Click any color swatch to copy its hex value"
                                      Style="{StaticResource CaptionTextBlockStyle}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                CornerRadius="8"
                                Margin="0,16,0,0">
                            <Image x:Name="ScreenshotDisplay"
                                    Stretch="Uniform"
                                    MaxHeight="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="12" />
                        </Border>

                        <TextBlock Grid.Row="2"
                                  Text="Color Palette"
                                  Style="{StaticResource SubtitleTextBlockStyle}"
                                  Margin="0,24,0,12" />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="PaletteLeft"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,6,0" />

                            <StackPanel x:Name="PaletteRight"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        HorizontalAlignment="Left"
                                        Margin="6,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
