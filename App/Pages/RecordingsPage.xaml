<Page
    x:Class="App.Pages.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Thickness x:Key="CardPadding">24</Thickness>
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
        <Storyboard x:Key="RecordingWaveStoryboard">
            <DoubleAnimation Storyboard.TargetName="RecordingWaveTransform"
                             Storyboard.TargetProperty="X"
                             From="-150"
                             To="220"
                             Duration="0:0:1.25"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="RecordingWave"
                             Storyboard.TargetProperty="Opacity"
                             From="0.18"
                             To="0.42"
                             Duration="0:0:0.62"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalScrollMode="Disabled"
                 Padding="20,16,20,32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="2"
                    x:Name="FinalizingPanel"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    MinHeight="240"
                    Margin="0">
                <Grid>
                    <StackPanel Width="380"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <ProgressRing Width="40"
                                      Height="40"
                                      IsActive="True"
                                      HorizontalAlignment="Center" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Saving your recording"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Please keep this window open while we prepare your video."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="FinalizingStatusText"
                                   Text="Writing your video…"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <ProgressBar Width="280"
                                     Height="6"
                                     IsIndeterminate="True"
                                     HorizontalAlignment="Center" />
                        <TextBlock x:Name="FinalizingCountdownText"
                                   Text="About a few seconds remaining"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Latest Recording -->
            <Border Grid.Row="2"
                    x:Name="LatestRecordingCard"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Margin="0">
                <StackPanel Padding="{StaticResource CardPadding}"
                            Spacing="18">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Recording saved"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Your video is ready to view."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="NewRecordingButton"
                                Grid.Column="1"
                                Content="Start a new recording"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,10"
                                VerticalAlignment="Center"
                                Click="NewRecordingButton_Click" />
                    </Grid>
                    <Button x:Name="LatestRecordingButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Click="LatestRecordingButton_Click">
                        <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                CornerRadius="8">
                            <Image x:Name="LatestRecordingImage"
                                   Stretch="Uniform"
                                   MaxHeight="420"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="12" />
                        </Border>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <TextBlock Text="Duration"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestRecordingDurationText"
                                       Text="00:00"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="FPS"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestRecordingFpsText"
                                       Text="0.0"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="4"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="File Size"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestRecordingFileSizeText"
                                       Text="0 MB"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Empty state and recording control -->
            <StackPanel x:Name="RecordingActionPanel"
                        Grid.Row="3"
                        Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        Spacing="24">
                <StackPanel x:Name="InfoPanel">
                    <FontIcon Glyph="&#xE7F4;"
                              FontSize="64"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Captures the primary display"
                              Style="{StaticResource SubtitleTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,16,0,4" />
                    <TextBlock Text="Click Start Recording to capture the entire screen"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center" />
                </StackPanel>
                <Button x:Name="RecordingButton"
                          Style="{StaticResource AccentButtonStyle}"
                          Padding="0"
                          HorizontalAlignment="Center"
                          Click="RecordingButton_Click">
                    <Grid MinWidth="145"
                          MinHeight="40">
                        <Border x:Name="RecordingButtonBase"
                                Background="Transparent"
                                CornerRadius="4">
                            <Grid>
                                <Border x:Name="RecordingWave"
                                        Width="112"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="4"
                                        Background="#55FFFFFF"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="RecordingWaveTransform"
                                                            X="-150" />
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="RecordingButtonLabel"
                                           Text="Start Recording"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="24,12" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
